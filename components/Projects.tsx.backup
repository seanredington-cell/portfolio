"use client";

import React, { useRef } from "react";
import { motion, useScroll, useTransform } from "framer-motion";
import Image from "next/image";
import Link from "next/link";
import { projectData } from "@/data/projects";

/**
 * Projects Section Component
 * 
 * Displays projects as full-width scroll-triggered cards.
 * Each card features:
 * - Hero image animating in from the left on an arc path
 * - Project name/description animating in from the right on an arc path
 * - Both elements converge near the center like two gears meeting
 * - Smooth, organic arc trajectories
 * - On mobile: cards stack vertically with simplified fade-in animations
 */
export default function Projects() {
  const containerRef = useRef<HTMLDivElement>(null);
  const [hoverIndex, setHoverIndex] = React.useState<number | null>(null);
  const [isCarouselHovered, setIsCarouselHovered] = React.useState(false);

  const { scrollYProgress: containerProgress } = useScroll({
    target: containerRef,
    offset: ["start start", "end end"],
  });

  return (
    <section ref={containerRef} data-projects-container className="relative" style={{ height: `${projectData.length * 100}vh` }}>
      {/* Fixed viewport - projects rotate through this */}
      <div className="sticky top-0 h-screen w-full flex items-center justify-center overflow-hidden">
        {/* Content container with padding and max-width */}
        <div className="w-full h-full flex items-center justify-center px-4 sm:px-8 lg:px-[168px] max-w-[1600px]">
          <div className="w-full h-full relative">
            {projectData.map((project, index) => (
              <ProjectCard
                key={project.id}
                project={project}
                index={index}
                containerRef={containerRef}
              />
            ))}
          </div>
        </div>

        {/* Carousel navigation - vertical on right side */}
        <div
          className="fixed right-3 top-1/2 -translate-y-1/2 z-[100]"
          onMouseEnter={() => setIsCarouselHovered(true)}
          onMouseLeave={() => setIsCarouselHovered(false)}
        >
          <motion.div
            className="backdrop-blur-sm bg-white/10 border border-white/60 shadow-2xl px-3 py-4 flex flex-col items-center gap-3"
            style={{
              boxShadow: '0 8px 32px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.5)',
            }}
            animate={{
              borderRadius: isCarouselHovered ? "24px" : "9999px",
            }}
            transition={{ duration: 0.3 }}
          >
            {/* Counter */}
            <motion.span
              className="text-xs text-gray-500 font-medium"
              animate={{
                opacity: isCarouselHovered ? 1 : 0.7,
              }}
            >
              {useTransform(containerProgress, (latest) => {
                const currentIndex = Math.round(latest * (projectData.length - 1));
                return `${currentIndex + 1} of ${projectData.length}`;
              })}
            </motion.span>

            {/* Project logos - vertical with overlap */}
            <div className="flex flex-col items-center relative">
              {projectData.map((project, index) => (
                <CarouselIndicator
                  key={project.id}
                  project={project}
                  index={index}
                  totalProjects={projectData.length}
                  containerProgress={containerProgress}
                  hoverIndex={hoverIndex}
                  setHoverIndex={setHoverIndex}
                  isCarouselHovered={isCarouselHovered}
                />
              ))}
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  );
}

/**
 * Carousel Indicator Component
 * Shows project logos with hover magnification and shape morphing
 */
function CarouselIndicator({
  project,
  index,
  totalProjects,
  containerProgress,
  hoverIndex,
  setHoverIndex,
  isCarouselHovered,
}: {
  project: typeof projectData[0];
  index: number;
  totalProjects: number;
  containerProgress: any;
  hoverIndex: number | null;
  setHoverIndex: (index: number | null) => void;
  isCarouselHovered: boolean;
}) {
  const isActive = useTransform(containerProgress, (value) => {
    const projectDuration = 1 / totalProjects;
    const projectStart = index * projectDuration;
    const projectEnd = (index + 1) * projectDuration;

    // Active when in the middle 60% of this project's scroll range
    const activeStart = projectStart + projectDuration * 0.2;
    const activeEnd = projectEnd - projectDuration * 0.2;

    return value >= activeStart && value <= activeEnd;
  });

  const handleClick = () => {
    // Calculate scroll position for this project
    const projectDuration = 1 / totalProjects;
    const targetProgress = (index + 0.5) * projectDuration;

    // Get container element and calculate scroll position
    const container = document.querySelector('[data-projects-container]');
    if (container) {
      const scrollHeight = container.scrollHeight - window.innerHeight;
      const targetScroll = scrollHeight * targetProgress;

      window.scrollTo({
        top: container.getBoundingClientRect().top + window.scrollY + targetScroll,
        behavior: 'smooth'
      });
    }
  };

  return (
    <div className="relative group">
      <motion.button
        className="relative cursor-pointer overflow-hidden border-2 border-white/70 w-8 h-8"
        onMouseEnter={() => setHoverIndex(index)}
        onMouseLeave={() => setHoverIndex(null)}
        onClick={handleClick}
        animate={{
          borderRadius: isCarouselHovered ? "8px" : "50%",
          marginTop: index === 0 ? 0 : (isCarouselHovered ? "8px" : "-12px"),
        }}
        transition={{ type: "spring", stiffness: 300, damping: 20 }}
        style={{
          zIndex: hoverIndex === index ? 10 : totalProjects - index,
          boxShadow: "0 4px 12px rgba(0,0,0,0.15), inset 0 1px 0 rgba(255,255,255,0.4)",
          backdropFilter: "blur(4px)",
        }}
      >
        {/* Glassmorphic backdrop */}
        <div className="absolute inset-0 bg-white/15" />

        {/* Color overlay */}
        <motion.div
          className="absolute inset-0"
          style={{
            backgroundColor: project.logoColor || "#E5E7EB",
            opacity: 0.6,
          }}
        />

        {/* Content */}
        <div className="relative w-full h-full flex items-center justify-center text-base">
          {project.logoPlaceholder || "📁"}
        </div>
      </motion.button>

      {/* Tooltip */}
      {hoverIndex === index && isCarouselHovered && (
        <motion.div
          initial={{ opacity: 0, x: -10 }}
          animate={{ opacity: 1, x: 0 }}
          exit={{ opacity: 0, x: -10 }}
          className="absolute right-full mr-3 top-0 whitespace-nowrap backdrop-blur-xl bg-white/90 border border-white/40 rounded-lg shadow-lg px-3 py-2 text-sm font-medium text-gray-700 pointer-events-none"
          style={{ zIndex: 1000 }}
        >
          {project.name}

          {/* Triangle arrow pointing to the icon */}
          <div className="absolute left-full top-1/2 -translate-y-1/2 w-0 h-0 border-t-[6px] border-t-transparent border-b-[6px] border-b-transparent border-l-[6px] border-l-white/40" />
          <div className="absolute left-full top-1/2 -translate-y-1/2 -ml-[1px] w-0 h-0 border-t-[5px] border-t-transparent border-b-[5px] border-b-transparent border-l-[5px] border-l-white/90"
            style={{ backdropFilter: 'blur(12px)' }}
          />
        </motion.div>
      )}
    </div>
  );
}

/**
 * Individual Project Card Component
 * 
 * Handles the arc animation logic for each project card.
 * Uses scroll position to drive animations along curved paths.
 */
function ProjectCard({
  project,
  index,
  containerRef,
}: {
  project: typeof projectData[0];
  index: number;
  containerRef: React.RefObject<HTMLDivElement>;
}) {
  const cardRef = useRef<HTMLDivElement>(null);
  
  // Get scroll progress for the entire container
  const { scrollYProgress: containerProgress } = useScroll({
    target: containerRef,
    offset: ["start start", "end end"],
  });

  // Map container progress to this specific project's window
  const scrollYProgress = useTransform(containerProgress, (value) => {
    const totalProjects = projectData.length;
    const projectDuration = 1 / totalProjects;
    const projectStart = index * projectDuration;
    const projectEnd = (index + 1) * projectDuration;

    if (value < projectStart) return 0;
    if (value > projectEnd) return 1;
    return (value - projectStart) / projectDuration;
  });

  // Add magnetic snap effect - items "stick" to center position with moderate stickiness
  const snappedProgress = useTransform(scrollYProgress, (value) => {
    // For first project, start locked at center (0.5), others animate in
    if (index === 0) {
      // First project: starts locked at 0.5 and only exits
      if (value <= 0.5) {
        // Moderate locked period: 0 to 0.5 stays at 0.5 (50% of scroll)
        return 0.5;
      } else if (value < 0.75) {
        // Gradual exit: 0.5 to 0.75 → 0.5 to 0.75
        const localProgress = (value - 0.5) / 0.25;
        return 0.5 + (localProgress * localProgress) * 0.25;
      } else {
        // Final exit phase: 0.75 to 1 → 0.75 to 1
        return 0.75 + ((value - 0.75) / 0.25) * 0.25;
      }
    }

    // Other projects: full animation with moderate sticky zone and gradual entry/exit
    if (value < 0.3) {
      // Gradual entry phase: 0 to 0.3 → 0 to 0.35
      return value * 1.167;
    } else if (value < 0.45) {
      // Magnetic pull approaching center: 0.3 to 0.45 → 0.35 to 0.48
      const localProgress = (value - 0.3) / 0.15;
      return 0.35 + (localProgress * localProgress) * 0.13;
    } else if (value < 0.5) {
      // Final snap into center: 0.45 to 0.5 → 0.48 to 0.5
      return 0.48 + ((value - 0.45) / 0.05) * 0.02;
    } else if (value <= 0.7) {
      // Moderate locked at center: 0.5 to 0.7 stays at 0.5 (20% of scroll)
      return 0.5;
    } else if (value < 0.85) {
      // Gradual release and exit: 0.7 to 0.85 → 0.5 to 0.75
      const localProgress = (value - 0.7) / 0.15;
      return 0.5 + (localProgress * localProgress) * 0.25;
    } else {
      // Final exit phase: 0.85 to 1 → 0.75 to 1
      return 0.75 + ((value - 0.85) / 0.15) * 0.25;
    }
  });


  // Arc path calculations
  // For desktop: create smooth arc paths that feel like two gears meeting
  // For mobile: simplify to fade-in

  // Helper function to create smooth arc curve using easing
  // Creates a more organic, gear-like motion
  const arcEase = (t: number) => {
    // Custom easing function for smooth arc: starts slow, accelerates, then decelerates
    return t < 0.5
      ? 2 * t * t * (3 - 2 * t) // Ease in-out with slight acceleration
      : 1 - Math.pow(-2 * t + 2, 3) / 2; // Smooth deceleration
  };

  // Image: follows a smooth arc path on the left side
  // Not a circle, but an elongated arc that travels far vertically
  const imageX = useTransform(snappedProgress, (latest) => {
    // Smooth arc on left side - minimal horizontal movement
    // Starts far left, moves slightly right at middle, returns left
    const horizontalAmplitude = 150; // Small horizontal movement
    const baseX = -200; // Base position on left side

    // Use sine for smooth arc motion
    const arcProgress = Math.sin(latest * Math.PI); // 0 -> 1 -> 0
    return baseX + (horizontalAmplitude * arcProgress);
  });

  const imageY = useTransform(snappedProgress, (progress) => {
    // Vertical travel - all items pass through y=0 and never go below
    // At progress 0.5: y = 0 (horizontal centerline)
    // At progress 0: y = 400 (above center)
    // At progress 1: y = -400 (exiting above)
    return 400 - (progress * 800);
  });

  const imageOpacity = useTransform(scrollYProgress,
    index === 0 ? [0, 0.85, 1] : [0, 0.15, 0.5, 0.85, 1],
    index === 0 ? [1, 1, 0] : [0, 1, 1, 1, 0]
  );
  const imageScale = useTransform(scrollYProgress,
    index === 0 ? [0, 0.85, 1] : [0, 0.15, 0.5, 0.85, 1],
    index === 0 ? [1, 1, 0.8] : [0.8, 1, 1, 1, 0.8]
  );

  // Text: follows a smooth arc path on the right side
  // Not a circle, but an elongated arc that travels far vertically
  const textX = useTransform(snappedProgress, (latest) => {
    // Smooth arc on right side - minimal horizontal movement
    // Starts far right, moves slightly left at middle, returns right
    const horizontalAmplitude = 150; // Small horizontal movement
    const baseX = 200; // Base position on right side

    // Use sine for smooth arc motion (mirrored from left)
    const arcProgress = Math.sin(latest * Math.PI); // 0 -> 1 -> 0
    return baseX - (horizontalAmplitude * arcProgress); // Subtract to mirror
  });

  const textY = useTransform(snappedProgress, (progress) => {
    // Vertical travel - same as image, aligned horizontally
    // At progress 0.5: y = 0 (horizontal centerline)
    // At progress 0: y = 400 (above center)
    // At progress 1: y = -400 (exiting above)
    return 400 - (progress * 800);
  });

  const textOpacity = useTransform(scrollYProgress,
    index === 0 ? [0, 0.85, 1] : [0, 0.15, 0.5, 0.85, 1],
    index === 0 ? [1, 1, 0] : [0, 1, 1, 1, 0]
  );
  const textScale = useTransform(scrollYProgress,
    index === 0 ? [0, 0.85, 1] : [0, 0.15, 0.5, 0.85, 1],
    index === 0 ? [1, 1, 0.8] : [0.8, 1, 1, 1, 0.8]
  );

  // Rotation: no rotation while locked, only rotate during entry and exit
  const imageRotate = useTransform(scrollYProgress, (latest) => {
    const baseRotation = index === 0
      ? (latest <= 0.6 ? 0 : ((latest - 0.6) / 0.4) * 4)
      : (latest < 0.4 ? -4 + (latest / 0.4) * 4 : (latest <= 0.85 ? 0 : ((latest - 0.85) / 0.15) * 4));

    return baseRotation;
  });

  const textRotate = useTransform(scrollYProgress, (latest) => {
    const baseRotation = index === 0
      ? (latest <= 0.6 ? 0 : -((latest - 0.6) / 0.4) * 4)
      : (latest < 0.4 ? 4 - (latest / 0.4) * 4 : (latest <= 0.85 ? 0 : -((latest - 0.85) / 0.15) * 4));

    return baseRotation;
  });

  const shouldRender = useTransform(scrollYProgress, (latest) => {
    return latest > 0.05 && latest < 0.95;
  });

  const [isVisible, setIsVisible] = React.useState(true);

  React.useEffect(() => {
    const unsubscribe = shouldRender.on('change', (value) => {
      setIsVisible(value);
    });
    return unsubscribe;
  }, [shouldRender]);

  if (!isVisible && index !== 0) {
    return null;
  }

  return (
    <motion.div
      ref={cardRef}
      className="absolute inset-0 w-full h-full flex items-center justify-center pointer-events-none"
      style={{
        opacity: useTransform(scrollYProgress, [0, 0.2, 0.5, 0.8, 1], [0, 1, 1, 1, 0])
      }}
    >
      {/* Mobile Layout: Stacked vertically with fade-in */}
      <div className="lg:hidden flex flex-col gap-6 w-full max-w-2xl px-4 pointer-events-auto">
        <motion.div
          style={{
            opacity: imageOpacity,
            scale: imageScale,
          }}
          className="w-full aspect-video relative rounded-lg overflow-hidden bg-gradient-to-br from-accent-primary/10 to-accent-primary/5"
        >
          {project.image ? (
            <Image
              src={project.image}
              alt={project.name}
              fill
              className="object-cover"
            />
          ) : (
            <div className="w-full h-full flex items-center justify-center text-accent-primary/30 text-sm">
              {project.imagePlaceholder}
            </div>
          )}
        </motion.div>
        
        <motion.div
          style={{
            opacity: textOpacity,
            scale: textScale,
          }}
          className="space-y-4"
        >
          <h3 className="text-2xl sm:text-3xl font-bold">
            <span className="text-accent-primary">{project.name}</span>
          </h3>
          <p className="text-base sm:text-lg text-[#4a4a4a] leading-relaxed">
            {project.description}
          </p>
          {!project.isHero && (
            <a
              href={`/projects/${project.id}`}
              className="inline-block bg-accent-primary text-white font-medium px-6 py-3 rounded-full hover:bg-accent-primary/90 transition-colors"
            >
              Read more →
            </a>
          )}
        </motion.div>
      </div>

      {/* Desktop Layout: Side-by-side with arc animations */}
      <div className="hidden lg:flex items-center justify-center gap-3 w-full pointer-events-auto">
        {project.isHero ? (
          <>
            {/* Hero layout: Text on left, Image on right */}
            <motion.div
              style={{
                x: imageX,
                y: imageY,
                opacity: imageOpacity,
                scale: imageScale,
                rotate: imageRotate,
              }}
              className="flex-1 min-w-0 space-y-5"
            >
              <h3 className="text-3xl md:text-4xl font-bold text-[#1a1a1a]">
                {project.name}
              </h3>
              {project.tagline && (
                <p className="text-lg md:text-xl text-accent-primary font-semibold">
                  {project.tagline}
                </p>
              )}
              <p className="text-lg md:text-xl text-[#4a4a4a] leading-relaxed">
                {project.description}
              </p>
            </motion.div>

            <motion.div
              style={{
                x: textX,
                y: textY,
                opacity: textOpacity,
                scale: textScale,
                rotate: textRotate,
              }}
              className="flex-1 min-w-0 aspect-[4/5] relative rounded-lg overflow-hidden bg-gradient-to-br from-accent-primary/10 to-accent-primary/5"
            >
              {project.image ? (
                <Image
                  src={project.image}
                  alt={project.name}
                  fill
                  className="object-cover"
                />
              ) : (
                <div className="w-full h-full flex items-center justify-center text-accent-primary/30 text-sm">
                  {project.imagePlaceholder}
                </div>
              )}
            </motion.div>
          </>
        ) : (
          <>
            {/* Project layout: Image on left, Text on right */}
            <motion.div
              style={{
                x: imageX,
                y: imageY,
                opacity: imageOpacity,
                scale: imageScale,
                rotate: imageRotate,
              }}
              className="flex-1 min-w-0 aspect-[4/5] relative rounded-lg overflow-hidden bg-gradient-to-br from-accent-primary/10 to-accent-primary/5"
            >
              {project.image ? (
                <Image
                  src={project.image}
                  alt={project.name}
                  fill
                  className="object-cover"
                />
              ) : (
                <div className="w-full h-full flex items-center justify-center text-accent-primary/30 text-sm">
                  {project.imagePlaceholder}
                </div>
              )}
            </motion.div>

            <motion.div
              style={{
                x: textX,
                y: textY,
                opacity: textOpacity,
                scale: textScale,
                rotate: textRotate,
              }}
              className="flex-1 min-w-0 space-y-5"
            >
              <div className="flex items-center gap-3">
                {project.logoPlaceholder && (
                  <div
                    className="w-12 h-12 rounded-xl flex items-center justify-center text-2xl shadow-md"
                    style={{
                      backgroundColor: project.logoColor || "#E5E7EB",
                    }}
                  >
                    {project.logoPlaceholder}
                  </div>
                )}
                <h3 className="text-3xl md:text-4xl font-bold">
                  <span className="text-accent-primary">{project.name}</span>
                </h3>
              </div>

              {/* Tags */}
              {project.tags && (
                <div className="flex flex-wrap gap-2">
                  {project.tags.sector && (
                    <span className="group relative backdrop-blur-xl bg-white/20 border border-white/40 rounded-2xl px-4 py-1.5 text-xs font-medium text-black shadow-sm overflow-hidden">
                      <div className="absolute inset-0 bg-gradient-to-br from-white/30 via-white/10 to-transparent pointer-events-none" />
                      <span className="relative">{project.tags.sector}</span>
                    </span>
                  )}
                  {project.tags.role && (
                    <span className="group relative backdrop-blur-xl bg-white/20 border border-white/40 rounded-2xl px-4 py-1.5 text-xs font-medium text-black shadow-sm overflow-hidden">
                      <div className="absolute inset-0 bg-gradient-to-br from-white/30 via-white/10 to-transparent pointer-events-none" />
                      <span className="relative">{project.tags.role}</span>
                    </span>
                  )}
                  {project.tags.timeline && (
                    <span className="group relative backdrop-blur-xl bg-white/20 border border-white/40 rounded-2xl px-4 py-1.5 text-xs font-medium text-black shadow-sm overflow-hidden">
                      <div className="absolute inset-0 bg-gradient-to-br from-white/30 via-white/10 to-transparent pointer-events-none" />
                      <span className="relative">{project.tags.timeline}</span>
                    </span>
                  )}
                </div>
              )}

              <p className="text-sm md:text-base text-black leading-relaxed">
                {project.description}
              </p>
              <a
                href={`/projects/${project.id}`}
                className="inline-block bg-accent-primary text-white font-medium px-8 py-3 rounded-full hover:bg-accent-primary/90 transition-colors"
              >
                Read more →
              </a>
            </motion.div>
          </>
        )}
      </div>
    </motion.div>
  );
}
